# ─────────────────────────────────────────────────────────────────────────────
# CollabSphere Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (replace with your actual URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/collabsphere?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string

# JWT expiry (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Server port (default: 5000)
PORT=5000

# React frontend origin (for CORS)
CLIENT_URL=http://localhost:5173
