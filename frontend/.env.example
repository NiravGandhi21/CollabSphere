# ─────────────────────────────────────────────────────────────────────────────
# CollabSphere Frontend Environment Variables (Example Template)
# Vite exposes variables prefixed with VITE_ to the browser client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (Default for local development)
# In production on a unified host (SERVE_STATIC=true), set to /api
# In production on separate hosting (e.g., Vercel/Netlify), set to your backend origin + /api
VITE_API_URL=http://localhost:5000/api
